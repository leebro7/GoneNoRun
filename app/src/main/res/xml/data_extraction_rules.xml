<?xml version="1.0" encoding="utf-8"?>
<!--
  应用数据备份/传输规则（零信任原则 8：数据最小化）

  本应用持有精确位置历史（HistoryLocation.db / SearchHistory.db），属于
  敏感个人信息。因此完全禁止云备份与设备间传输，避免位置轨迹离开设备。

  与 AndroidManifest 中的 android:allowBackup="false" 配合使用；
  dataExtractionRules 用于 Android 12+，fullBackupContent 用于 Android 11-。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
