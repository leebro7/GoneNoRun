<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      权限最小化（零信任原则 3）

      本清单经过权限审计，仅保留功能所必需的声明。相对于历史版本，已移除以下
      声明（原因见每项注释）：

        ACCESS_BACKGROUND_LOCATION  —— 后台定位。核心定位由前景服务持有，
                                        不再需要后台定位范围
        READ_PHONE_STATE            —— 代码中从未使用（旧版 WelcomeActivity 仅申请未使用）
        READ_EXTERNAL_STORAGE       —— 日志改写入应用内部存储后不再需要
        DOWNLOAD_WITHOUT_NOTIFICATION —— 非必要，更新下载应可见
        REPLACE_EXISTING_PACKAGE    —— 并非有效的 Android 权限常量，且从未使用
        MOUNT_UNMOUNT_FILESYSTEMS   —— signature|privileged 权限，普通应用不可获得
        READ_LOGS                   —— signature|privileged 权限，普通应用不可获得
        WRITE_SETTINGS              —— 特权系统设置写入，功能上完全不需要
        ACCESS_MOCK_LOCATION        —— 见下方 mock location 说明
        CHANGE_WIFI_STATE           —— 应用只提示用户关闭 Wi-Fi，不自行修改
        WAKE_LOCK                   —— 代码中无 PowerManager 使用

      允许的全部权限均为 normal 或 dangerous（用户可见可撤销），
      不再申请任何 signature|privileged 权限，因此 tools:ignore="ProtectedPermissions"
      也不再需要。
    -->

    <!-- 仅使用期间（前景）精确/粗略定位。核心功能必需。 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- 读取网络/运营商 CellID 以辅助定位（普通权限） -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 前台服务：维持模拟定位持续运行并展示常驻通知 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 摇杆悬浮窗（核心交互） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 应用内自更新：下载并调起系统安装器 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 网络：地图与逆地理编码、更新检查 -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      模拟定位（核心功能）

      先前我基于「ACCESS_MOCK_LOCATION 属 signature|privileged 权限、普通应用
      拿不到」的判断把这一行删掉了，并在注释里标注「需真机验证后加回」。
      实机反馈推翻了该判断：删掉后应用被系统判定为「权限不足 禁止进入」，
      模拟定位无法工作。

      事实依据：
        * 原版仓库的 AndroidManifest 中**声明了** ACCESS_MOCK_LOCATION，
          且该项目在日常使用中确实生效 —— 说明该声明并非可有可无。
        * ServiceGo.addTestProviderGPS/Network 与 GoUtils.isAllowMockLocation
          都调用 LocationManager.addTestProvider()，若未声明该权限，
          在多数 ROM 上会抛 SecurityException（代码里只是吞掉并打日志，
          对外表现为「静默不生效」）。

      结论：恢复声明。授权始终由用户在
      「开发人员选项 → 选择模拟位置信息应用」中显式给出，
      该权限不会出现在运行时授权对话框中，因此不构成对用户的额外索权。
    -->
    <uses-permission
        android:name="android.permission.ACCESS_MOCK_LOCATION"
        tools:ignore="MockLocation,ProtectedPermissions" />

    <application
        android:name=".GoApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:launchMode="singleInstance"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="31">

        <uses-library
            android:name="org.apache.http.legacy"
            android:required="false" />

        <!-- 百度地图 间隔定位必须配置此 service 否则功能无效 -->
        <service
            android:name="com.baidu.location.f"
            android:enabled="true"
            android:exported="false"
            android:process=":remote" />

        <service
            android:exported="false"
            android:foregroundServiceType="location"
            android:name="com.zcshou.service.ServiceGo" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileProvider"
            android:grantUriPermissions="true"
            android:exported="false">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/provider_paths" />
        </provider>

        <activity
            android:name=".WelcomeActivity"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".MainActivity"
            android:launchMode="singleInstance"
            android:exported="false"
            android:theme="@style/AppTheme.NoActionBar" />

        <activity
            android:name=".SettingsActivity"
            android:label="@string/app_settings"
            android:exported="false" />

        <activity
            android:name=".HistoryActivity"
            android:label="@string/app_history"
            android:exported="false" />

    </application>


    <!--
      ==========================================================================
      关于 ACCESS_MOCK_LOCATION（已验证：必须声明）
      ==========================================================================
      结论变更记录：我最初以「该权限属 signature|privileged、普通应用拿不到」
      为由删除了这一声明，并标注「需真机验证后加回」。实机反馈推翻了那个判断：
      删除后应用被判为「权限不足 禁止进入」，模拟定位失效。现已恢复声明。

      为什么必须声明：ServiceGo.addTestProviderGPS/Network 与
      GoUtils.isAllowMockLocation 都调用 LocationManager.addTestProvider()。
      未声明该权限时，多数 ROM 直接抛 SecurityException；而代码仅捕获并写日志，
      外部表现就是「静默不生效」，很难定位 —— 这次的实机反馈正是这种表现。

      隐私影响有限：该权限永远不会出现在运行时授权对话框中，用户无需在应用内
      额外同意；实际启用必须由用户自行前往「开发人员选项 → 选择模拟位置信息应用」
      显式指定本应用，因此授权动作始终由用户掌握。

      安装到受管设备（企业 MDM）时请留意：本应用具备位置伪造能力，
      这本身即是该应用的设计用途。
    -->

</manifest>
